---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeftNav from '../../components/LeftNav.astro';
import ProfileSidebar from '../../components/ProfileSidebar.astro';
import Footer from '../../components/Footer.astro';
import { siteData } from '../../data/profile';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (d: Date) =>
  `${d.getFullYear()} 年 ${d.getMonth() + 1} 月 ${d.getDate()} 日`;
---

<BaseLayout title={`${post.data.title} | 博客`} description={post.data.description}>
  <div class="three-col-layout">
    <!-- 左栏：文章归档 -->
    <aside class="col-left">
      <LeftNav />
    </aside>

    <!-- 中栏：文章正文 -->
    <main class="col-middle">
      <div class="main-card article-card">
        <div class="reading-column">
          <nav class="read-nav" aria-label="文章导航">
            <a class="back-link" href="/#overview">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="m12 5-7 7 7 7M5 12h14" />
              </svg>
              <span>返回首页</span>
            </a>
          </nav>

          <article>
            <header class="read-header">
              <time class="read-date" datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
              <h1 class="read-title">{post.data.title}</h1>
            </header>

            <div class="prose">
              <Content />
            </div>
          </article>

          <Footer copyright={siteData.footer.copyright} />
        </div>
      </div>
    </main>

    <!-- 右栏：个人档案名片 -->
    <aside class="col-right">
      <ProfileSidebar data={siteData} />
    </aside>
  </div>
</BaseLayout>

<style>
  .article-card {
    padding: 32px clamp(24px, 2vw, 40px);
    scrollbar-gutter: stable;
  }

  .reading-column {
    width: 100%;
    max-width: 1100px;
    margin-inline: auto;
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
  }

  .read-nav {
    display: flex;
    margin-bottom: 36px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 8px 14px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-page);
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.18s ease, background-color 0.18s ease, border-color 0.18s ease;
  }

  .back-link svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .back-link:hover {
    color: var(--primary);
    background: var(--tag-bg);
    border-color: #bfdbfe;
  }

  .back-link:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
  }

  .read-header {
    padding-bottom: 28px;
    margin-bottom: 28px;
    border-bottom: 1px solid #eef2f7;
  }

  .read-date {
    font-size: 0.84rem;
    color: #94a3b8;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.03em;
  }

  .read-title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 1.6vw, 2rem);
    font-weight: 700;
    color: #0f172a;
    line-height: 1.45;
    margin-top: 12px;
    overflow-wrap: anywhere;
  }

  .prose {
    font-size: 1.02rem;
    color: var(--text-main);
  }

  .prose :global(p) {
    line-height: 1.95;
    margin-bottom: 1.3em;
    text-align: justify;
  }

  .prose :global(p:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 767px) {
    .article-card {
      padding: 24px 20px;
    }

    .read-nav {
      margin-bottom: 28px;
    }

    .read-header {
      padding-bottom: 22px;
      margin-bottom: 22px;
    }

    .prose {
      font-size: 1rem;
    }
  }
</style>
