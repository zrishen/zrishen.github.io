---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleNav from '../../components/ArticleNav.astro';
import ProfileSidebar from '../../components/ProfileSidebar.astro';
import Footer from '../../components/Footer.astro';
import { siteData } from '../../data/profile';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const formatDate = (d: Date) =>
  `${d.getFullYear()} 年 ${d.getMonth() + 1} 月 ${d.getDate()} 日`;
---

<BaseLayout title={`${post.data.title} | 博客`} description={post.data.description}>
  <div class="three-col-layout">
    <!-- 左栏：文章归档 -->
    <aside class="col-left">
      <ArticleNav title={post.data.title} headings={headings} />
    </aside>

    <!-- 中栏：文章正文 -->
    <main class="col-middle">
      <div class="main-card article-card">
        <div class="reading-column">
          <nav class="read-nav" aria-label="文章导航">
            <a class="back-link" href="/#overview">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="m12 5-7 7 7 7M5 12h14" />
              </svg>
              <span>返回首页</span>
            </a>
          </nav>

          <article>
            <header class="read-header">
              <h1 class="read-title">{post.data.title}</h1>
              <time class="read-date" datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
            </header>

            <div class="prose">
              <Content />
            </div>
          </article>

          <Footer note={siteData.footer.note} />
        </div>
      </div>
    </main>

    <!-- 右栏：个人档案名片 -->
    <aside class="col-right">
      <ProfileSidebar data={siteData} />
    </aside>
  </div>
</BaseLayout>

<style>
  .article-card {
    padding: 32px clamp(24px, 2vw, 40px);
    scrollbar-gutter: stable;
  }

  .reading-column {
    width: 100%;
    max-width: 1100px;
    margin-inline: auto;
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
  }

  .read-nav {
    display: flex;
    margin-bottom: 22px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 0;
    font-size: var(--fs-xs);
    font-weight: 500;
    line-height: 1.4;
    color: var(--text-light);
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .back-link svg {
    width: 13px;
    height: 13px;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.18s ease;
  }

  .back-link:hover {
    color: var(--primary);
  }

  .back-link:hover svg {
    transform: translateX(-2px);
  }

  .back-link:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
    border-radius: 3px;
  }

  .read-header {
    padding-bottom: 28px;
    margin-bottom: 28px;
    border-bottom: 1px solid #eef2f7;
  }

  .read-title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 1.6vw, var(--fs-2xl));
    font-weight: 700;
    color: #0f172a;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .read-date {
    display: block;
    margin-top: 10px;
    font-size: var(--fs-sm);
    color: #94a3b8;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.03em;
  }

  .prose {
    font-size: var(--fs-body);
    color: var(--text-main);
  }

  .prose :global(p) {
    line-height: 1.95;
    margin-bottom: 1.3em;
    text-align: justify;
  }

  .prose :global(p:last-child) {
    margin-bottom: 0;
  }

  /* 正文插图：限宽限高居中，保持原比例；超高图自动缩小，避免占满整屏 */
  .prose :global(img) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 480px;
    margin: 1.6em auto;
    border: 1px solid #eef2f7;
    border-radius: 8px;
  }

  /* 图注：小字居中灰，紧跟在图下方 */
  .prose :global(.caption) {
    text-align: center;
    font-size: var(--fs-sm);
    line-height: 1.7;
    color: #94a3b8;
    margin: -1em 0 1.6em;
  }

  /* 分点列表：跟随正文行距与缩进 */
  .prose :global(ul) {
    padding-left: 1.35em;
    margin: 0 0 1.3em;
  }

  .prose :global(li) {
    line-height: 1.95;
    text-align: justify;
  }

  .prose :global(li + li) {
    margin-top: 0.35em;
  }

  .prose :global(li::marker) {
    color: #94a3b8;
  }

  /* 正文链接：主色，平时无下划线，悬停加深并出现下划线 */
  .prose :global(a) {
    color: var(--primary);
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .prose :global(a:hover) {
    color: var(--primary-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* 正文小标题：与左侧目录的锚点一一对应 */
  .prose :global(h2) {
    font-family: var(--font-serif);
    font-size: var(--fs-xl);
    font-weight: 700;
    color: #0f172a;
    line-height: 1.5;
    margin: 2.4em 0 0.9em;
    scroll-margin-top: 32px;
  }

  .prose :global(h3) {
    font-size: var(--fs-lg);
    font-weight: 700;
    color: #1f2937;
    line-height: 1.5;
    margin: 1.9em 0 0.7em;
    scroll-margin-top: 32px;
  }

  /* 独立成行的公式与主线链路：始终单行不折行，窄屏时横向滚动；居中 */
  .prose :global(.formula),
  .prose :global(.roadmap) {
    text-align: center;
    white-space: nowrap;
    overflow-x: auto;
    font-size: 1.04em;
    line-height: 2.3;
    color: #0f172a;
    margin: 1.4em 0 1.6em;
  }

  .prose :global(.roadmap) {
    font-weight: 600;
  }

  /* 上下标：显式偏移定位，不依赖字体自带的上下标度量 */
  .prose :global(sub) {
    vertical-align: -0.25em;
    font-size: 0.75em;
    line-height: 0;
  }

  .prose :global(sup) {
    vertical-align: 0.5em;
    font-size: 0.75em;
    line-height: 0;
  }

  /* 关键句强调：正文里的点睛句 */
  .prose :global(.highlight) {
    color: #c0392b;
    font-weight: 600;
  }

  @media (max-width: 767px) {
    .article-card {
      padding: 24px 20px;
    }

    .read-nav {
      margin-bottom: 18px;
    }

    .read-header {
      padding-bottom: 22px;
      margin-bottom: 22px;
    }

    .prose {
      font-size: var(--fs-body);
    }
  }
</style>
