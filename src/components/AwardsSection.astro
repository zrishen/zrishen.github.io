---
import type { AwardItem } from '../data/types';

interface Props {
  awards: AwardItem[];
}

const { awards } = Astro.props;
---

<div class="section-block" id="awards">
  <h2 class="section-title">
    <i class="fa-solid fa-trophy"></i> 荣誉与竞赛奖项
  </h2>
  <ul class="award-list">
    {awards.map((award) => (
      <li class="award-item">
        <span class="award-name">{award.name}</span>
        <span class="award-date">{award.date}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .award-list {
    list-style: none;
  }

  .award-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px dashed #f1f5f9;
    font-size: 0.92rem;
  }

  .award-item:last-child {
    border-bottom: none;
  }

  .award-name {
    color: var(--text-main);
  }

  .award-date {
    color: var(--text-light);
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .award-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }
  }
</style>
