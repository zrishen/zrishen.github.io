---
import type { ProjectItem } from '../data/types';

interface Props {
  projects: ProjectItem[];
}

const { projects } = Astro.props;
---

<section class="section" id="projects">
  <h2 class="section-title">
    <i class="fa-solid fa-flask"></i> 科研与实践项目
  </h2>
  {projects.map((project) => (
    <div class="item">
      <div class="item-header">
        <div class="item-title">
          {project.title}
          {project.tag && <span class="tag">{project.tag}</span>}
        </div>
        <div class="item-date">{project.period}</div>
      </div>
      <div class="item-desc">{project.description}</div>
    </div>
  ))}
</section>

<style>
  .item {
    margin-bottom: 20px;
  }

  .item:last-child {
    margin-bottom: 0;
  }

  .item-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 4px;
  }

  .item-title {
    font-size: 1.02rem;
    font-weight: 600;
    color: #1e293b;
  }

  .item-date {
    font-size: 0.85rem;
    color: var(--text-light);
    font-weight: 500;
  }

  .item-desc {
    font-size: 0.92rem;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .item-header {
      flex-direction: column;
      gap: 2px;
    }
  }
</style>
