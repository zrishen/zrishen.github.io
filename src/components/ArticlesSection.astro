---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const formatDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<div class="article-stream">
  <header class="stream-header">
    <h2 class="stream-title">博客</h2>
    <p class="stream-subtitle">记录思考、科研与生活</p>
  </header>

  <div class="article-list">
    {posts.map((post) => (
      <a class="article-row" href={`/blog/${post.id}/`}>
        <time class="article-date" datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        <div class="article-row-main">
          <h3 class="article-title">{post.data.title}</h3>
          {post.data.description && (
            <p class="article-desc">{post.data.description}</p>
          )}
        </div>
        <span class="article-arrow" aria-hidden="true">→</span>
      </a>
    ))}
  </div>
</div>

<style>
  .article-stream {
    display: flex;
    flex-direction: column;
  }

  .stream-header {
    padding-bottom: 6px;
  }

  .stream-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    color: #0f172a;
    letter-spacing: 0.02em;
  }

  .stream-subtitle {
    font-size: 0.88rem;
    color: var(--text-light);
    margin-top: 4px;
  }

  .article-list {
    margin-top: 10px;
  }

  .article-row {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 22px 4px;
    border-bottom: 1px solid #eef2f7;
    text-decoration: none;
  }

  .article-row:last-child {
    border-bottom: none;
  }

  .article-date {
    flex-shrink: 0;
    width: 92px;
    font-size: 0.82rem;
    color: #94a3b8;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  .article-row-main {
    min-width: 0;
  }

  .article-title {
    font-family: var(--font-serif);
    font-size: 1.14rem;
    font-weight: 600;
    color: #1e293b;
    line-height: 1.5;
    transition: color 0.18s ease;
  }

  .article-desc {
    font-size: 0.88rem;
    color: var(--text-light);
    line-height: 1.7;
    margin-top: 6px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-arrow {
    flex-shrink: 0;
    margin-left: auto;
    color: var(--primary);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .article-row:hover .article-title,
  .article-row:focus-visible .article-title {
    color: var(--primary);
  }

  .article-row:hover .article-arrow,
  .article-row:focus-visible .article-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .article-row:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
    border-radius: 6px;
  }

  @media (max-width: 767px) {
    .article-row {
      flex-direction: column;
      gap: 6px;
      padding: 18px 2px;
    }

    .article-date {
      width: auto;
    }

    .article-arrow {
      display: none;
    }
  }
</style>
