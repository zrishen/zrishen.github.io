---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const formatDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<div class="article-stream">
  <header class="stream-header">
    <h2 class="stream-title">文章</h2>
    <p class="stream-subtitle">记录思考、科研与生活</p>
    <button type="button" class="filter-note" hidden></button>
  </header>

  <div class="article-list">
    {posts.map((post) => (
      <a class="article-row" href={`/blog/${post.id}/`} data-date={post.data.date.toISOString().slice(0, 10)}>
        <time class="article-date" datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        <div class="article-row-main">
          <h3 class="article-title">{post.data.title}</h3>
          {post.data.description && (
            <p class="article-desc">{post.data.description}</p>
          )}
        </div>
      </a>
    ))}
  </div>

  <p class="stream-empty" hidden>这段时间还没有文章。</p>
</div>

<style>
  .article-stream {
    display: flex;
    flex-direction: column;
  }

  .stream-header {
    padding-bottom: 6px;
  }

  .stream-title {
    font-family: var(--font-serif);
    font-size: var(--fs-xl);
    font-weight: 700;
    color: #0f172a;
    letter-spacing: 0.02em;
  }

  .stream-subtitle {
    font-size: var(--fs-sm);
    color: var(--text-light);
    margin-top: 4px;
  }

  .article-list {
    margin-top: 10px;
    transition: opacity 0.14s ease;
  }

  /* 切换筛选时先淡出、换完再淡入，避免列表硬切 */
  .article-list.is-fading {
    opacity: 0;
  }

  /* 有作者样式 display 时 [hidden] 会失效，这里显式关掉 */
  .article-row[hidden] {
    display: none;
  }
  /* 筛选状态条：本身就是按钮，点一下回到全部 */
  .filter-note {
    margin-top: 12px;
    padding: 4px 12px;
    font: inherit;
    font-size: var(--fs-sm);
    color: var(--primary);
    background: #eff6ff;
    border: 1px solid #dbeafe;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.18s ease;
  }

  .filter-note:hover {
    background: #dbeafe;
  }
  .stream-empty {
    padding: 32px 4px;
    font-size: var(--fs-sm);
    color: var(--text-light);
  }

  .article-row {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 22px 4px;
    border-bottom: 1px solid #eef2f7;
    text-decoration: none;
    transition: background-color 0.18s ease, box-shadow 0.18s ease;
  }

  /* 悬停：极浅底 + 左侧一道主色细条，整行有反应，但不抢标题变色的主次 */
  .article-row:hover,
  .article-row:focus-visible {
    background-color: #f8fafc;
    box-shadow: inset 2px 0 0 var(--primary);
  }

  .article-row:last-child {
    border-bottom: none;
  }

  .article-date {
    flex-shrink: 0;
    width: 92px;
    font-size: var(--fs-sm);
    color: #94a3b8;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  .article-row-main {
    min-width: 0;
  }

  .article-title {
    font-family: var(--font-serif);
    font-size: var(--fs-lg);
    font-weight: 600;
    color: #1e293b;
    line-height: 1.5;
    transition: color 0.18s ease;
  }

  .article-desc {
    font-size: var(--fs-sm);
    color: var(--text-light);
    line-height: 1.7;
    margin-top: 6px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-row:hover .article-title,
  .article-row:focus-visible .article-title {
    color: var(--primary);
  }

  .article-row:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
    border-radius: 6px;
  }

  @media (max-width: 767px) {
    .article-row {
      flex-direction: column;
      gap: 6px;
      padding: 18px 2px;
    }

    .article-date {
      width: auto;
    }

    .article-arrow {
      display: none;
    }
  }
</style>
