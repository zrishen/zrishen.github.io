---
import type { SkillCategory } from '../data/types';

interface Props {
  skills: SkillCategory[];
}

const { skills } = Astro.props;
---

<div class="section-block" id="skills">
  <h2 class="section-title">
    <i class="fa-solid fa-layer-group"></i> 专业技能
  </h2>
  <div class="skills-grid">
    {skills.map((category) => (
      <div class="skill-card">
        <div class="skill-card-title">
          <i class={category.icon} style="color:#2563eb;"></i> {category.title}
        </div>
        <div class="skill-card-text">
          {category.skills.join(', ')}
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 14px;
  }

  .skill-card {
    background: #f8fafc;
    border: 1px solid #f1f5f9;
    border-radius: 10px;
    padding: 16px;
  }

  .skill-card-title {
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 6px;
    color: #1e293b;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .skill-card-text {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.5;
  }
</style>
